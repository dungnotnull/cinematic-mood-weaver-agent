# ── Cinematic Mood Weaver — Environment Variables ──────────────────
# Copy this file to .env and fill in your credentials.

# ── LLM API Keys ───────────────────────────────────────────────────
# At least one LLM backend must be configured.
# Claude is the primary, GPT-4 is fallback, Ollama is local offline fallback.

CLAUDE_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── External Service API Keys ──────────────────────────────────────
# Required for music and movie recommendations.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TMDB_API_KEY=

# ── Smart Home ─────────────────────────────────────────────────────
# Optional — lighting control works without these (graceful fallback).

HUE_BRIDGE_IP=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# ── Data Encryption ────────────────────────────────────────────────
# Optional — if not set, a random key is generated per session.

ENCRYPTION_KEY=

# ── Runtime Settings ───────────────────────────────────────────────
# These can be overridden at runtime via the UI or pipeline config.

# DB_PATH=~/.cinematic-mood-weaver/data.db
# AUDIO_SAMPLE_RATE=16000
# AUDIO_WINDOW_SECONDS=3.0
# SER_POLL_INTERVAL_SECONDS=300
# CONFIDENCE_THRESHOLD=0.6
# ENABLE_LIGHTING=true
# ENABLE_BIOMETRICS=false
# ENABLE_AROMATHERAPY=false
# PREFERRED_LLM_BACKEND=claude
